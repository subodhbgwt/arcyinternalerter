# Copy to .env and fill in. .env is gitignored - never commit real values.

# From @BotFather. Can be a brand-new bot or an existing one.
TELEGRAM_BOT_TOKEN=

# Recipient's chat id. Have them message the bot once, then:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and read result[0].message.chat.id
TELEGRAM_CHAT_ID=

# Only alert on postings newer than this many days.
MAX_AGE_DAYS=2

# Only used with --loop.
DIGEST_INTERVAL_HOURS=24

# Optional: extra location tokens to accept, comma-separated.
# e.g. INDIA_LOCATIONS=Bhiwadi,Sri City
INDIA_LOCATIONS=

# Optional: extra internship title tokens, comma-separated.
INTERN_KEYWORDS=

# Set to 1 to always scrape the 134 jobspy companies (~30 min per run).
USE_JOBSPY=

# Set to 1 to also fetch the browser-only Workday tenants (needs Playwright).
USE_BROWSER=
